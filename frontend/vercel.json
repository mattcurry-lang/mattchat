{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/supabase/:path*",
      "destination": "https://bqerkvywgxoiocbkxif.supabase.co/:path*"
    },
    {
      "source": "/((?!sitemap.xml|robots.txt|api/).*)",
      "destination": "/index.html"
    }
  ]
}
